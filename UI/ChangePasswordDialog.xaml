<Window x:Class="TunnelGate.UI.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Vault Password"
        Height="610"
        Width="620"
        MinHeight="610"
        MinWidth="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        Icon="/Assets/TunnelGate.ico">
    <Border Margin="16"
            Background="#0B121D"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="52" Height="52" CornerRadius="15"
                        Background="{StaticResource AccentDark}"
                        VerticalAlignment="Top">
                    <Image Source="/Assets/TunnelGateIcon.png" Stretch="Uniform" Margin="6"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="TUNNELGATE SECURITY"
                               Foreground="{StaticResource Accent}"
                               FontSize="10.5"
                               FontWeight="Bold"/>
                    <TextBlock Text="Change vault password"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="Re-encrypt the local vault with a new master password."
                               Foreground="{StaticResource Muted}"
                               FontSize="12.5"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Padding="9,5"
                        Background="#0D1D18"
                        BorderBrush="#214A39"
                        BorderThickness="1"
                        CornerRadius="999"
                        VerticalAlignment="Top">
                    <TextBlock Text="LOCAL • AES-256-GCM"
                               Foreground="#83DCB0"
                               FontSize="9.5"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,22,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="#0F1724"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="15"
                            Padding="18">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Credentials"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Verify the current password, then choose the replacement."
                                               Foreground="{StaticResource Muted}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          x:Name="ShowPasswordCheck"
                                          Content="Show passwords"
                                          VerticalAlignment="Center"
                                          Checked="ShowPasswordCheck_Changed"
                                          Unchecked="ShowPasswordCheck_Changed"/>
                            </Grid>

                            <TextBlock Text="Current password"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,18,0,7"/>
                            <Grid>
                                <PasswordBox x:Name="OldBox"
                                             Height="48"
                                             FontSize="16"
                                             FontFamily="Segoe UI"
                                             FontWeight="SemiBold"
                                             PasswordChanged="OldBox_PasswordChanged"/>
                                <TextBox x:Name="OldRevealBox"
                                         Height="48"
                                         FontSize="16"
                                         FontFamily="Segoe UI"
                                         FontWeight="SemiBold"
                                         Foreground="#FFFFFF"
                                         Visibility="Collapsed"
                                         TextChanged="OldRevealBox_TextChanged"/>
                            </Grid>

                            <TextBlock Text="New password"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,16,0,7"/>
                            <Grid>
                                <PasswordBox x:Name="NewBox"
                                             Height="48"
                                             FontSize="16"
                                             FontFamily="Segoe UI"
                                             FontWeight="SemiBold"
                                             PasswordChanged="NewBox_PasswordChanged"/>
                                <TextBox x:Name="NewRevealBox"
                                         Height="48"
                                         FontSize="16"
                                         FontFamily="Segoe UI"
                                         FontWeight="SemiBold"
                                         Foreground="#FFFFFF"
                                         Visibility="Collapsed"
                                         TextChanged="NewRevealBox_TextChanged"/>
                            </Grid>

                            <TextBlock Text="Confirm new password"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,16,0,7"/>
                            <Grid>
                                <PasswordBox x:Name="ConfirmBox"
                                             Height="48"
                                             FontSize="16"
                                             FontFamily="Segoe UI"
                                             FontWeight="SemiBold"
                                             PasswordChanged="ConfirmBox_PasswordChanged"/>
                                <TextBox x:Name="ConfirmRevealBox"
                                         Height="48"
                                         FontSize="16"
                                         FontFamily="Segoe UI"
                                         FontWeight="SemiBold"
                                         Foreground="#FFFFFF"
                                         Visibility="Collapsed"
                                         TextChanged="ConfirmRevealBox_TextChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Background="#0A151E"
                            BorderBrush="#1D3342"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24"
                                    Background="#123226"
                                    CornerRadius="7">
                                <TextBlock Text="✓"
                                           Foreground="{StaticResource Accent}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Use at least 6 characters. Changing the password also refreshes the DPAPI-protected session key used for background tunnel auto-start."
                                       Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border x:Name="ErrorPanel"
                            Margin="0,12,0,0"
                            Background="#261217"
                            BorderBrush="#5A2932"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText"
                                   Foreground="#FF8994"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Your vault stays local on this Windows account."
                           Foreground="{StaticResource Muted2}"
                           FontSize="10.5"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Cancel"
                        Click="Cancel_Click"
                        Width="115"
                        MinHeight="46"/>
                <Button Grid.Column="3"
                        Content="Change password"
                        Click="Change_Click"
                        Style="{StaticResource SuccessButton}"
                        Width="155"
                        MinHeight="46"/>
            </Grid>
        </Grid>
    </Border>
</Window>
