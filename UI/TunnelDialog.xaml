<Window x:Class="TunnelGate.UI.TunnelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tunnel"
        Height="770"
        Width="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" Icon="/Assets/TunnelGate.ico">
    <Border Margin="14" Background="#0B121D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="TunnelGate" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="Tunnel configuration" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <TextBlock Text="Split the configuration across focused tabs so add/edit feels cleaner and easier to work with." Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <TabControl Grid.Row="1" Margin="0,18,0,0">
                <TabItem Header="Connection">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Background="#0F1724" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="6">
                            <StackPanel>
                                <TextBlock Text="Core connection settings" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Define identity, mode and SSH authentication." Foreground="{StaticResource Muted}" Margin="0,4,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="1" Text="Mode" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ModeBox" Margin="0,4,0,4" SelectionChanged="ModeBox_SelectionChanged">
                                        <ComboBoxItem Content="Reverse (-R)" Tag="reverse"/>
                                        <ComboBoxItem Content="SOCKS Proxy (-D)" Tag="proxy"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Text="SSH host" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="RemoteHostBox" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="3" Text="SSH port" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="SshPortBox" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="4" Text="SSH username" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="UserBox" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="5" Text="SSH password" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <Grid Grid.Row="5" Grid.Column="1" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid>
                                            <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>
                                            <TextBox x:Name="PasswordRevealBox" Visibility="Collapsed" TextChanged="PasswordRevealBox_TextChanged"/>
                                        </Grid>
                                        <Button Grid.Column="1" x:Name="ShowPasswordButton" Content="Show" Click="ShowPasswordButton_Click" Margin="10,0,0,0" Width="88"/>
                                    </Grid>

                                    <TextBlock Grid.Row="6" Text="Key file" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <Grid Grid.Row="6" Grid.Column="1" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="KeyFileBox"/>
                                        <Button Grid.Column="1" Content="Browse" Click="BrowseKey_Click" Margin="10,0,0,0" Width="88"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Routing">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Background="#0F1724" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="6">
                            <StackPanel>
                                <TextBlock Text="Routing and bind targets" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Define server-side and local endpoints for this tunnel." Foreground="{StaticResource Muted}" Margin="0,4,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" x:Name="RemoteBindLabel" Text="Remote bind" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="RemoteBindBox" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="1" x:Name="RemotePortLabel" Text="Remote port" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="RemotePortBox" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="2" Text="Local host / bind" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="LocalHostBox" Margin="0,4,0,4"/>

                                    <TextBlock Grid.Row="3" Text="Local port" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="LocalPortBox" Margin="0,4,0,4"/>
                                </Grid>
                                <Border Margin="0,16,0,0" Background="#0B121D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Quick notes" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Reverse mode exposes a server-side port and forwards traffic to a local destination. SOCKS mode uses the local bind and local port fields." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Automation">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Background="#0F1724" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="6">
                            <StackPanel>
                                <TextBlock Text="Flags and automation" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Control runtime state, secure storage and restart behavior." Foreground="{StaticResource Muted}" Margin="0,4,0,14"/>
                                <CheckBox x:Name="EnabledBox" Content="Enable this tunnel"/>
                                <CheckBox x:Name="SavePasswordBox" Content="Save SSH password in the encrypted vault"/>
                                <CheckBox x:Name="AutoRestartBox" Content="Enable scheduled per-tunnel restart" Margin="0,4,0,10"/>
                                <Border Background="#0B121D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Restart after" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                        <TextBox Grid.Column="1" x:Name="DaysBox" Margin="0,4,0,4"/>
                                        <TextBlock Grid.Column="2" Text="days" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="8,0"/>
                                        <TextBox Grid.Column="3" x:Name="HoursBox" Margin="0,4,0,4"/>
                                        <TextBlock Grid.Column="4" Text="hours" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="8,0"/>
                                        <TextBox Grid.Column="5" x:Name="MinutesBox" Margin="0,4,0,4"/>
                                        <TextBlock Grid.Column="6" Text="min" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="8,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="{StaticResource Danger}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Click="Cancel_Click" Width="100"/>
                <Button Content="Save" Click="Save_Click" Background="#174D35" BorderBrush="#285F48" Width="100"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
