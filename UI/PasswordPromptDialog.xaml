<Window x:Class="TunnelGate.UI.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password"
        Height="310"
        Width="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" Icon="/Assets/TunnelGate.ico">
    <Border Margin="14" Background="#0B121D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="TunnelGate Security" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="PromptText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Password" Foreground="{StaticResource Muted}" Margin="0,14,0,6"/>
            <Grid Grid.Row="2">
                <PasswordBox x:Name="PasswordBox" Height="44" FontSize="15" PasswordChanged="PasswordBox_PasswordChanged"/>
                <TextBox x:Name="PasswordRevealBox" Height="44" FontSize="15" Visibility="Collapsed" TextChanged="PasswordRevealBox_TextChanged"/>
            </Grid>

            <StackPanel Grid.Row="3" x:Name="ConfirmPanel" Visibility="Collapsed">
                <TextBlock Text="Confirm password" Foreground="{StaticResource Muted}" Margin="0,14,0,6"/>
                <Grid>
                    <PasswordBox x:Name="ConfirmBox" Height="44" FontSize="15" PasswordChanged="ConfirmBox_PasswordChanged"/>
                    <TextBox x:Name="ConfirmRevealBox" Height="44" FontSize="15" Visibility="Collapsed" TextChanged="ConfirmRevealBox_TextChanged"/>
                </Grid>
            </StackPanel>

            <CheckBox Grid.Row="4" x:Name="ShowPasswordCheck" Content="Show password" Margin="0,12,0,0" Checked="ShowPasswordCheck_Changed" Unchecked="ShowPasswordCheck_Changed"/>
            <TextBlock Grid.Row="5" x:Name="ErrorText" Foreground="{StaticResource Danger}" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Click="Cancel_Click"/>
                <Button Content="OK" Click="Ok_Click" Background="#174D35" BorderBrush="#285F48"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
