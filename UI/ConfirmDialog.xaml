<Window x:Class="TunnelGate.UI.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Height="280"
        Width="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" Icon="/Assets/TunnelGate.ico">
    <Border Margin="14" Background="#0B121D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="TunnelGate" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Warning}"/>
                <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" Background="#0E1521" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,18,0,0">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Text}"/>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Width="110" MinHeight="46" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Content="Delete" Width="120" MinHeight="46" Style="{StaticResource DangerButton}" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
